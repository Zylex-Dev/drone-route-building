# ============================================================================
# Database Configuration
# ============================================================================
# Строка подключения к PostgreSQL
# Формат: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://droneuser:dronepass2024@postgres:5432/drone_missions
POSTGRES_USER=droneuser
POSTGRES_PASSWORD=dronepass2024
POSTGRES_DB=drone_missions
# ============================================================================
# JWT Configuration
# ============================================================================
# Секретный ключ для подписи JWT токенов
# КРИТИЧНО: Замените на уникальный ключ в production!
# 
# Генерация безопасного ключа:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#   или
#   openssl rand -base64 64
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars-required-for-security

# Алгоритм подписи JWT
JWT_ALGORITHM=HS256

# Срок действия токена (в днях)
JWT_EXPIRE_DAYS=7

# ============================================================================
# Application Settings
# ============================================================================
APP_NAME=Drone Route Auth Service
APP_VERSION=1.0.0

# Режим отладки (True для разработки, False для production)
DEBUG=False

# ============================================================================
# ВАЖНО: Безопасность
# ============================================================================
# 1. Никогда не коммитьте .env в git (файл уже в .gitignore)
# 2. В production используйте:
#    - Сложный пароль БД (минимум 16 символов)
#    - Уникальный JWT_SECRET_KEY (минимум 64 символа)
# 3. Для локальной разработки эти значения подходят
# 4. Используйте HTTPS в production
# ============================================================================